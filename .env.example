# Copy to .env and fill in.

# The camera's IP address on your LAN (find it in your router's client list, or
# scan for a device with ports 554 and 34567 open).
FRIGATE_OWL_BOX_HOST=192.0.2.10

# The camera's "admin" device password (set in the Green Backyard app),
# URL-encoded because it is used inside an RTSP URL:
#   $ -> %24   ! -> %21   @ -> %40   : -> %3A   # -> %23   / -> %2F
FRIGATE_OWL_BOX_PASSWORD=your_url_encoded_password_here
