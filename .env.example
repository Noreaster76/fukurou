# Copy to .env and fill in.

# The camera's IP address on your LAN (find it in your router's client list, or
# scan for a device with ports 554 and 34567 open).
FRIGATE_OWL_BOX_HOST=192.0.2.10

# The camera's "admin" device password (set in the Green Backyard app),
# URL-encoded because it is used inside an RTSP URL:
#   $ -> %24   ! -> %21   @ -> %40   : -> %3A   # -> %23   / -> %2F
FRIGATE_OWL_BOX_PASSWORD=your_url_encoded_password_here

# Optional: where recordings and snapshots go. On the Pi, the dedicated
# recordings partition. Defaults to ./storage next to docker-compose.yml.
# FRIGATE_MEDIA_DIR=/mnt/fukurou/frigate

# Host network setup (host/install.sh): this Pi's LAN address and interface,
# which the camera is configured to use as its gateway, and the LAN subnet.
FUKUROU_PI_IP=192.0.2.20
FUKUROU_PI_IFACE=eth0
FUKUROU_LAN_CIDR=192.0.2.0/24
